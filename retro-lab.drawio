82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="isp-24" target="isp-61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="isp-63" value="&lt;b&gt;Home 2 · XP&lt;/b&gt;&lt;br&gt;OpenWrt · PPPoE + CGNAT&lt;br&gt;IPv6 /56 PD&lt;br&gt;LAN 192.168.1.0/24&lt;br&gt;1 VM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1636" y="960" width="145" height="140" as="geometry"/></mxCell><mxCell id="isp-64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=none;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="isp-25" target="isp-63"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="isp-65" value="&lt;b&gt;spare 4th home&lt;/b&gt;&lt;br&gt;BNG-B3 IPoE&lt;br&gt;public IPv4 + /56 PD&lt;br&gt;(no VM yet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="1788" y="960" width="145" height="140" as="geometry"/></mxCell><mxCell id="isp-66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=9;endArrow=none;strokeWidth=2;strokeColor=#82b366;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="isp-26" target="isp-65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="isp-67" value="&lt;b&gt;Ent 3 multi-homed&lt;/b&gt;: prod on ISP A (PE-A3), DR on ISP B (PE-B1), both announce the PI 198.19.0.0/24. &lt;b&gt;Ent 2&lt;/b&gt; has different public IPs per site (DR failover = DNS change). Ent 1/2/3 sites also hold their Windows VMs behind the CPE (page 2). Unpatchable OSes have no route to mgt/shr or the real internet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1130" width="1870" height="50" as="geometry"/></mxCell><mxCell id="isp-68" value="&lt;b&gt;Lab management zone (proposal, Class C)&lt;/b&gt;: zone &lt;code&gt;lab&lt;/code&gt;, VLAN 70, 192.168.77.0/24 (check zones.yaml). Members: router and LXC management NICs only (VyOS eth0, FRR/BIRD). Reachable from mgt/shr for Ansible later; no route from the lab into it (management VRF on VyOS). Windows guests are used through the Proxmox console." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1200" width="1870" height="55" as="geometry"/></mxCell><mxCell id="isp-69" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Thick blue = submarine cable (netem latency/loss) · orange = eBGP · dashed purple = iBGP to the RR · green = access link (PE–CE /31, PPPoE/IPoE) · dashed grey box = spare&lt;br&gt;Platforms: VyOS VM (Stream/rolling, cloud-init template) for PE, BNG, P, Border and 2 CPEs · FRR/BIRD LXC for carriers and IX peers · OpenWrt VM for 7 CPEs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="1275" width="1870" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="win" name="2 Customers and Windows guests"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="win-1" value="Retro lab — customer sites and Windows guests (27 VMs)&lt;br&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;Each enterprise: prod + DR, each with 2 DCs, 1 member server, 1 client. Per-site LAN /24: CPE .1, DC1 .10, DC2 .11, member .20, DHCP .100–.199. Disks IDE; NIC pcnet/ne2k (98, NT4), rtl8139 (2K, XP, 2003).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="win-2" value="&lt;b&gt;Enterprise 1 · NT4 · domain ENT1 (no AD)&lt;/b&gt; · uplink PE-A1 / PE-A2 (ISP A, L3VPN)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1500" height="20" as="geometry"/></mxCell><mxCell id="win-3" value="prod · LAN 10.1.1.0/24" style="swimlane;rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;swimlaneFillColor=#f3f9f0;fontSize=12;fontStyle=1;startSize=30;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="740" height="200" as="geometry"/></mxCell><mxCell id="win-4" value="DC1 · .10&lt;br&gt;NT4 Server PDC&lt;br&gt;WINS + DHCP&lt;br&gt;128 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-3"><mxGeometry x="15" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-5" value="DC2 · .11&lt;br&gt;NT4 Server BDC&lt;br&gt;WINS&lt;br&gt;128 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-3"><mxGeometry x="195" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-6" value="Member · .20&lt;br&gt;NT4 Server&lt;br&gt;file/print&lt;br&gt;128 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-3"><mxGeometry x="375" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-7" value="Client&lt;br&gt;NT4 Workstation&lt;br&gt;128 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft