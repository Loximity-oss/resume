="90" as="geometry"/></mxCell><mxCell id="win-27" value="Client&lt;br&gt;Win2K Pro&lt;br&gt;256 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-23"><mxGeometry x="555" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-28" value="CPE gateway 10.2.2.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="win-23"><mxGeometry x="15" y="150" width="710" height="35" as="geometry"/></mxCell><mxCell id="win-29" value="One AD site per physical site (Prod, DR) with a site link. 2.0 GB RAM, 26 GB disk." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="1500" height="20" as="geometry"/></mxCell><mxCell id="win-30" value="&lt;b&gt;Enterprise 3 · Server 2003 · ent3.lab (ENT3)&lt;/b&gt; · uplink PE-A3 prod / PE-B1 DR (eBGP, VyOS CPE)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1500" height="20" as="geometry"/></mxCell><mxCell id="win-31" value="prod · LAN 10.3.1.0/24" style="swimlane;rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;swimlaneFillColor=#f3f9f0;fontSize=12;fontStyle=1;startSize=30;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="675" width="740" height="200" as="geometry"/></mxCell><mxCell id="win-32" value="DC1 · .10&lt;br&gt;Server 2003&lt;br&gt;AD DNS + DHCP&lt;br&gt;384 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-31"><mxGeometry x="15" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-33" value="DC2 · .11&lt;br&gt;Server 2003&lt;br&gt;AD DNS + GC&lt;br&gt;384 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-31"><mxGeometry x="195" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-34" value="Member · .20&lt;br&gt;Server 2003&lt;br&gt;512 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-31"><mxGeometry x="375" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-35" value="Client&lt;br&gt;XP SP3&lt;br&gt;512 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-31"><mxGeometry x="555" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-36" value="CPE gateway 10.3.1.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="win-31"><mxGeometry x="15" y="150" width="710" height="35" as="geometry"/></mxCell><mxCell id="win-37" value="DR · LAN 10.3.2.0/24" style="swimlane;rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#82b366;swimlaneFillColor=#f3f9f0;fontSize=12;fontStyle=1;startSize=30;arcSize=4;" vertex="1" parent="1"><mxGeometry x="820" y="675" width="740" height="200" as="geometry"/></mxCell><mxCell id="win-38" value="DC1 · .10&lt;br&gt;Server 2003&lt;br&gt;AD DNS + DHCP&lt;br&gt;384 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-37"><mxGeometry x="15" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-39" value="DC2 · .11&lt;br&gt;Server 2003&lt;br&gt;AD DNS + GC&lt;br&gt;384 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-37"><mxGeometry x="195" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-40" value="Member · .20&lt;br&gt;Server 2003&lt;br&gt;512 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-37"><mxGeometry x="375" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-41" value="Client&lt;br&gt;XP SP3&lt;br&gt;512 MB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-37"><mxGeometry x="555" y="45" width="170" height="90" as="geometry"/></mxCell><mxCell id="win-42" value="CPE gateway 10.3.2.1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d79b00;fontSize=10;align=center;" vertex="1" parent="win-37"><mxGeometry x="15" y="150" width="710" height="35" as="geometry"/></mxCell><mxCell id="win-43" value="AD sites Prod and DR. 3.5 GB RAM, 36 GB disk." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="878" width="1500" height="20" as="geometry"/></mxCell><mxCell id="win-44" value="Home subscribers (1 VM each, behind an OpenWrt CPE)" style="swimlane;rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#666666;swimlaneFillColor=#fafafa;fontSize=12;fontStyle=1;startSize=30;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1500" height="150" as="geometry"/></mxCell><mxCell id="win-45" value="&lt;b&gt;Home 1 · Win 98 SE&lt;/b&gt;&lt;br&gt;128 MB · 1 GB&lt;br&gt;PPPoE, public IPv4, no IPv6&lt;br&gt;install AmnHLT or Rain (98 busy-loops)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-44"><mxGeometry x="15" y="45" width="470" height="90" as="geometry"/></mxCell><mxCell id="win-46" value="&lt;b&gt;Home 2 · XP SP3&lt;/b&gt;&lt;br&gt;512 MB · 4 GB&lt;br&gt;PPPoE + CGNAT, /56 PD&lt;br&gt;LAN 192.168.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-44"><mxGeometry x="505" y="45" width="470" height="90" as="geometry"/></mxCell><mxCell id="win-47" value="&lt;b&gt;Home 3 · Vista SP2&lt;/b&gt;&lt;br&gt;2 vCPU · 1.5 GB · 16 GB&lt;br&gt;IPoE + CGNAT, /56 PD&lt;br&gt;LAN 192.168.1.0/24 (own NAT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=10;align=left;verticalAlign=top;spacingLeft=4;" vertex="1" parent="win-44"><mxGeometry x="995" y="45" width="470" height="90" as="geometry"/></mxCell><mxCell id="win-48" value="&lt;b&gt;Sizing (lean)&lt;/b&gt;&lt;br&gt;&lt;table style='border-collapse:collapse;font-size:10px'&gt;&lt;tr&gt;&lt;th style='text-align:left;padding:1px 6px;border-bottom:1px solid #999'&gt;OS / role&lt;/th&gt;&lt;th style='text-align:left;padding:1px 6px;border-bottom:1px solid #999'&gt;vCPU&lt;/th&gt;&lt;th style='text-align:left;padding:1px 6px;border-bottom:1px solid #999'&gt;RAM&lt;/th&gt;&lt;th style='text-align:left;padding:1px 6px;border-bottom:1px solid #999'&gt;Disk&lt;/th&gt;&lt;th style='text-align:left;padding:1px 6px;border-bottom:1px solid #999'&gt;Count&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;NT4 Server (PDC, BDC, member)&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;128 MB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;2 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;NT4 Workstation&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;128 MB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;2 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Win2K Server DC / member&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;256 MB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;3 / 4 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;4 / 2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Win2K Pro&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;256 MB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;3 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Server 2003 DC / member&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;384 / 512 MB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;4 / 6 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;4 / 2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;XP SP3&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;512 MB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;4 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Win 98 SE&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;128 MB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Vista SP2&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;2&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1.5 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;16 GB&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;&lt;b&gt;Total&lt;/b&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;&lt;b&gt;~10 GB&lt;/b&gt; (incl. ~1.3 GB QEMU)&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;&lt;b&gt;~99 GB&lt;/b&gt; (~25 GB linked clones)&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;&lt;b&gt;27&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="760" height="230" as="geometry"/></mxCell><mxCell id="win-49" value="&lt;b&gt;Build notes&lt;/b&gt;&lt;br&gt;Templates + linked clones: NT4 member/Workstation, Win2K Server/Pro, 2003, XP (Sysprep 1.1 or NewSID for NT4).&lt;br&gt;Fresh installs: 4 NT4 DCs, Win 98, Vista.&lt;br&gt;NT4 needs CPU type pentium3 or kvm32. Fixed pagefile 1–1.5× RAM; System Restore off (XP, Vista).&lt;br&gt;System disks can't be extended on 98/NT4/2K/2003: add a 2–4 GB data disk. These OSes send no discards: clone deltas only grow.&lt;br&gt;Manual ISO installs first; Terraform/Ansible later." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d79b00;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="820" y="1100" width="720" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="addr" name="3 ASNs and addressing"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="addr-1" value="Retro lab — ASNs, blocks and sizing&lt;br&gt;&lt;span style='font-size:11px;font-weight:normal'&gt;'Public' space only from test/doc ranges: IPv4 198.18.0.0/15, IPv6 3fff::/20, ASNs 64496–64511 and 65536–65551. CGNAT 100.64.0.0/10. Customer LANs RFC 1918. Nothing overlaps the real homelab (192.168.67–76.0, 10.255.253.0/24).&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1600" height="60" as="geometry"/></mxCell><mxCell id="addr-2" value="&lt;b&gt;ASNs&lt;/b&gt;&lt;br&gt;&lt;table style='border-collapse:collapse;font-size:10px'&gt;&lt;tr&gt;&lt;th style='text-align:left;padding:1px 6px;border-bottom:1px solid #999'&gt;Network&lt;/th&gt;&lt;th style='text-align:left;padding:1px 6px;border-bottom:1px solid #999'&gt;ASN&lt;/th&gt;&lt;th style='text-align:left;padding:1px 6px;border-bottom:1px solid #999'&gt;Notes&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Tier-1 backbone&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64496&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;joins the two cable carriers&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Cable 1 carrier&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64497&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;transit for ISP A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Cable 2 carrier&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64498&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;transit for ISP B&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;ISP A&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64500&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;ISP B&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;65536&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;4-byte on purpose (asplain/asdot)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Fake CDN&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64502&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;IX peer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Fake cloud&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64503&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;IX peer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Fake third ISP&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64504&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;IX peer&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Enterprise 3&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64505&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;multi-homed to A and B&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;IX route server&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64510&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;transparent, not in AS path&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;Spare&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;64506–09, 64511, 65537–51&lt;/td&gt;&lt;td style='padding:1px 6px;vertical-align:top'&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=10;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"